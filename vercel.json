{
  "buildCommand": "vite build && node scripts/generate-meta.js",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/services/officers", "destination": "/security-officers", "permanent": true },
    { "source": "/services/patrol", "destination": "/mobile-patrol", "permanent": true },
    { "source": "/services/remote", "destination": "/remote-video-monitoring", "permanent": true },
    { "source": "/services/surveillance", "destination": "/surveillance-systems", "permanent": true },
    { "source": "/services/access", "destination": "/access-control", "permanent": true },
    { "source": "/services/autonomous", "destination": "/autonomous-surveillance", "permanent": true },
    { "source": "/services/maintenance", "destination": "/service-maintenance", "permanent": true },
    { "source": "/security-operations-center", "destination": "/technology/soc", "permanent": true },
    { "source": "/fpi-technology-platform", "destination": "/technology/platform", "permanent": true }
  ],
  "rewrites": [
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/security-officers", "destination": "/security-officers/index.html" },
    { "source": "/mobile-patrol", "destination": "/mobile-patrol/index.html" },
    { "source": "/remote-video-monitoring", "destination": "/remote-video-monitoring/index.html" },
    { "source": "/surveillance-systems", "destination": "/surveillance-systems/index.html" },
    { "source": "/access-control", "destination": "/access-control/index.html" },
    { "source": "/autonomous-surveillance", "destination": "/autonomous-surveillance/index.html" },
    { "source": "/service-maintenance", "destination": "/service-maintenance/index.html" },
    { "source": "/services/(.*)", "destination": "/services/index.html" },
    { "source": "/technology/soc", "destination": "/technology/soc/index.html" },
    { "source": "/technology/platform", "destination": "/technology/platform/index.html" },
    { "source": "/industries", "destination": "/industries/index.html" },
    { "source": "/industries/hoa-residential-security", "destination": "/industries/hoa-residential-security/index.html" },
    { "source": "/industries/construction-site-security", "destination": "/industries/construction-site-security/index.html" },
    { "source": "/industries/commercial-office-building-security", "destination": "/industries/commercial-office-building-security/index.html" },
    { "source": "/industries/healthcare-security-services", "destination": "/industries/healthcare-security-services/index.html" },
    { "source": "/industries/car-dealership-security", "destination": "/industries/car-dealership-security/index.html" },
    { "source": "/industries/warehouse-industrial-security", "destination": "/industries/warehouse-industrial-security/index.html" },
    { "source": "/industries/retail-shopping-center-security", "destination": "/industries/retail-shopping-center-security/index.html" },
    { "source": "/industries/hotel-security-services", "destination": "/industries/hotel-security-services/index.html" },
    { "source": "/locations", "destination": "/locations/index.html" },
    { "source": "/locations/pembroke-pines-fl", "destination": "/locations/pembroke-pines-fl/index.html" },
    { "source": "/locations/dallas-tx", "destination": "/locations/dallas-tx/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
